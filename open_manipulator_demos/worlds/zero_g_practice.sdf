<sdf version="1.10">
  <world name="zero_g_practice">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <gravity>0 0 0</gravity>
    <magnetic_field>0 0 0</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.35 0.38 0.42 1</ambient>
      <background>0.02 0.025 0.035 1</background>
      <shadows>true</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0.6 -0.9 0.55 0 0.42 2.2</pose>
      </camera>
    </gui>

    <light name="work_light" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.4</intensity>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.9 0.92 1.0 1</diffuse>
      <specular>0.2 0.2 0.25 1</specular>
    </light>

    <model name="reference_plane">
      <static>true</static>
      <pose>0 0 -0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.5 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.10 0.12 1</ambient>
            <diffuse>0.10 0.12 0.14 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="approach_marker">
      <static>true</static>
      <pose>-0.02 -0.115 0.21 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.012</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.65 1.0 1</ambient>
            <diffuse>0.2 0.65 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hold_marker">
      <static>true</static>
      <pose>-0.04 -0.11 0.205 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.012</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 1.0 0.45 1</ambient>
            <diffuse>0.2 1.0 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="retreat_marker">
      <static>true</static>
      <pose>-0.06 -0.10 0.19 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.012</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.45 0.2 1</ambient>
            <diffuse>1.0 0.45 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="workspace_bounds">
      <static>true</static>
      <pose>-0.04 -0.12 0.20 0 0 0</pose>
      <link name="link">
        <visual name="x_min">
          <pose>-0.18 0 0 0 0 0</pose>
          <geometry><box><size>0.005 0.36 0.30</size></box></geometry>
          <transparency>0.85</transparency>
        </visual>
        <visual name="x_max">
          <pose>0.18 0 0 0 0 0</pose>
          <geometry><box><size>0.005 0.36 0.30</size></box></geometry>
          <transparency>0.85</transparency>
        </visual>
        <visual name="y_min">
          <pose>0 -0.18 0 0 0 0</pose>
          <geometry><box><size>0.36 0.005 0.30</size></box></geometry>
          <transparency>0.85</transparency>
        </visual>
        <visual name="y_max">
          <pose>0 0.18 0 0 0 0</pose>
          <geometry><box><size>0.36 0.005 0.30</size></box></geometry>
          <transparency>0.85</transparency>
        </visual>
        <visual name="z_min">
          <pose>0 0 -0.15 0 0 0</pose>
          <geometry><box><size>0.36 0.36 0.005</size></box></geometry>
          <transparency>0.85</transparency>
        </visual>
        <visual name="z_max">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.36 0.36 0.005</size></box></geometry>
          <transparency>0.85</transparency>
        </visual>
      </link>
    </model>

    <model name="floating_sample">
      <static>false</static>
      <pose>-0.08 -0.20 0.205 0 0 0</pose>
      <link name="sample_link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>0.000005</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.000005</iyy>
            <iyz>0</iyz>
            <izz>0.000005</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.025</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.2</mu>
                <mu2>0.2</mu2>
              </ode>
            </friction>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.025</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.22 1</ambient>
            <diffuse>0.95 0.75 0.22 1</diffuse>
            <specular>0.45 0.4 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
