<sdf version="1.10">
  <world name="tabletop_practice">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>0 0 0</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.35 0.38 0.42 1</ambient>
      <background>0.025 0.030 0.035 1</background>
      <shadows>true</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0.45 -0.75 0.45 0 0.45 2.4</pose>
      </camera>
    </gui>

    <light name="work_light" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>-0.35 0.2 -0.9</direction>
      <diffuse>0.9 0.92 1.0 1</diffuse>
      <specular>0.2 0.2 0.25 1</specular>
    </light>

    <model name="tabletop_table">
      <static>true</static>
      <pose>-0.05 -0.18 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.24 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.24 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.14 0.16 0.17 1</ambient>
            <diffuse>0.16 0.18 0.19 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="pickup_cube">
      <static>true</static>
      <pose>-0.08 -0.20 0.035 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.025 0.025 0.025</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.025 0.025 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.72 0.20 1</ambient>
            <diffuse>0.95 0.72 0.20 1</diffuse>
            <specular>0.45 0.4 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="place_zone">
      <static>true</static>
      <pose>-0.13 -0.14 0.023 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.65 0.95 1</ambient>
            <diffuse>0.15 0.65 0.95 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
